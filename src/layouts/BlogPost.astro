---
import Layout from './Layout.astro';
import { SITE } from '../site.config';

const { frontmatter } = Astro.props;
const baseRaw = import.meta.env.BASE_URL;
const base = baseRaw.endsWith('/') ? baseRaw : baseRaw + '/';

const published = new Date(frontmatter.date);
const publishedIso = published.toISOString();
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: publishedIso,
  dateModified: publishedIso,
  inLanguage: 'nl-NL',
  keywords: frontmatter.tags?.join(', '),
  mainEntityOfPage: canonical,
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('blog/', SITE.url).href },
    { '@type': 'ListItem', position: 3, name: frontmatter.title, item: canonical },
  ],
};
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  type="article"
  publishedTime={publishedIso}
  jsonLd={[articleLd, breadcrumbLd]}
>
  <article class="py-12">
    <div class="max-w-3xl mx-auto px-6">
      <!-- Back link -->
      <a href={`${base}blog/`} class="text-brass hover:underline text-sm mb-8 inline-block">
        ← Terug naar blog
      </a>

      <!-- Header -->
      <header class="mb-8">
        <div class="flex items-center gap-4 text-sm text-gray-500 mb-4">
          <time datetime={publishedIso}>{published.toLocaleDateString('nl-NL', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          {frontmatter.tags && (
            <span class="text-brass">•</span>
            <span>{frontmatter.tags[0]}</span>
          )}
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold mb-4 font-display">
          {frontmatter.title}
        </h1>
        {frontmatter.description && (
          <p class="text-xl text-gray-600">{frontmatter.description}</p>
        )}
      </header>

      <!-- Content -->
      <div class="blog-content">
        <slot />
      </div>

      <!-- Tags -->
      {frontmatter.tags && (
        <div class="mt-12 pt-8 border-t border-gray-200">
          <div class="flex flex-wrap gap-2">
            {frontmatter.tags.map((tag: string) => (
              <span class="px-3 py-1 bg-cream rounded-full text-sm text-gray-600">{tag}</span>
            ))}
          </div>
        </div>
      )}

      <!-- CTA -->
      <div class="mt-12 p-8 bg-cream rounded-2xl text-center">
        <h3 class="text-xl font-bold mb-2">Interesse in meespelen?</h3>
        <p class="text-gray-600 mb-4">In het najaar van 2026 gaan we weer van start. Meld je nu aan!</p>
        <a href={`${base}aanmelden/`} class="btn-primary">Aanmelden voor 2026 →</a>
      </div>
    </div>
  </article>
</Layout>
